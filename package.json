{
  "name": "dsh-display-manager",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Sidebar fold and display management: collapse the sidebar panel list, and choose which plugin entries appear in the sidebar, the conversation header/footer, tabs and Settings. Display only — it never enables or disables a plugin.",
  "author": "Roambus",
  "license": "MIT",
  "homepage": "https://github.com/Roambus/dsh-display-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roambus/dsh-display-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Roambus/dsh-display-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "ui",
    "display",
    "fold"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
